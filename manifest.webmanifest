{
  "name": "VyCheckout",
  "short_name": "VyCheckout",
  "description": "Payment links for creators — get paid by card or PayPal.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f6f4",
  "theme_color": "#18181b",
  "categories": ["business", "finance", "shopping"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New collection", "url": "/?source=app&go=p-nc", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Withdraw", "url": "/?source=app&go=p-wd", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
